<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="ni.uam.edu.proyectohibernateg3.controller.LibroController"
      prefWidth="800.0"
      prefHeight="600.0"
      spacing="12.0">

    <padding>
        <Insets top="20.0"
                right="20.0"
                bottom="20.0"
                left="20.0"/>
    </padding>

    <Label text="Registro de libros"
           style="-fx-font-size: 22px; -fx-font-weight: bold;"/>

    <GridPane hgap="10.0" vgap="10.0">

        <Label text="Título:"
               GridPane.columnIndex="0"
               GridPane.rowIndex="0"/>

        <TextField fx:id="txtTitulo"
                   prefWidth="300.0"
                   promptText="Título del libro"
                   GridPane.columnIndex="1"
                   GridPane.rowIndex="0"/>

        <Label text="Autor:"
               GridPane.columnIndex="0"
               GridPane.rowIndex="1"/>

        <TextField fx:id="txtAutor"
                   promptText="Autor del libro"
                   GridPane.columnIndex="1"
                   GridPane.rowIndex="1"/>

        <Label text="Año:"
               GridPane.columnIndex="0"
               GridPane.rowIndex="2"/>

        <TextField fx:id="txtAnio"
                   promptText="Año de publicación"
                   GridPane.columnIndex="1"
                   GridPane.rowIndex="2"/>

        <Label text="Precio:"
               GridPane.columnIndex="0"
               GridPane.rowIndex="3"/>

        <TextField fx:id="txtPrecio"
                   promptText="Precio del libro"
                   GridPane.columnIndex="1"
                   GridPane.rowIndex="3"/>

    </GridPane>

    <HBox spacing="10.0">

        <Button text="Guardar libro"
                onAction="#guardarLibro"/>

        <Button fx:id="btnModificar"
                text="Modificar libro"
                disable="true"
                onAction="#modificarLibro"/>

        <Button fx:id="btnEliminar"
                text="Eliminar libro"
                disable="true"
                onAction="#eliminarLibro"/>

        <Button text="Cargar libros"
                onAction="#cargarLibros"/>

        <Button text="Limpiar campos"
                onAction="#limpiarCampos"/>

    </HBox>

    <TableView fx:id="tablaLibros"
               prefHeight="350.0"
               VBox.vgrow="ALWAYS">

        <placeholder>
            <Label text="No hay libros registrados"/>
        </placeholder>

        <columns>

            <TableColumn fx:id="colId"
                         text="ID"
                         prefWidth="60.0"/>

            <TableColumn fx:id="colTitulo"
                         text="Título"
                         prefWidth="250.0"/>

            <TableColumn fx:id="colAutor"
                         text="Autor"
                         prefWidth="220.0"/>

            <TableColumn fx:id="colAnio"
                         text="Año"
                         prefWidth="90.0"/>

            <TableColumn fx:id="colPrecio"
                         text="Precio"
                         prefWidth="110.0"/>

        </columns>

    </TableView>

</VBox>